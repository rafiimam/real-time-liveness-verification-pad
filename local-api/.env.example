# Prefer a dedicated DB. If using special chars in password, URL-encode them (@ -> %40)
DATABASE_URL=postgresql://user:password@localhost:5432/liveness_db

# --- Production / pilot auth ---
# Set a strong API_KEY before exposing the service. AUTH_REQUIRED defaults true when API_KEY is set.
API_KEY=change-me-client-api-key
ADMIN_API_KEY=change-me-admin-api-key
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRE_MINUTES=30
AUTH_REQUIRED=true
CORS_ORIGINS=https://liveness.example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Session binding
SESSION_TTL_SECONDS=120
REQUIRE_NONCE=true
GPU_SERVER_URL=http://localhost:8000
ALLOW_VERIFY_UPLOAD=false
HIGH_VALUE_REQUIRE_LIVE_WS=true
HIGH_VALUE_AMOUNT=100000

# Face match
AZURE_FACE_ENDPOINT=https://your-face-resource.cognitiveservices.azure.com/
AZURE_FACE_SUBSCRIPTION_KEY=
AZURE_FACE_MATCH_THRESHOLD=0.7
FACEMATCH_URL=http://localhost:8001
FACE_MATCH_FAIL_CLOSED=true
SKIP_FACE_MATCH=false

# Liveness gates — keep all required in production (no soft-pass / modality waiver)
SPATIAL_LIVENESS_THRESHOLD=0.5
REQUIRE_SPATIAL=true
SPATIAL_MIN_PASS_FRACTION=0.6
LIVENESS_WEIGHT_SPATIAL=0.40
LIVENESS_WEIGHT_TEMPORAL=0.35
LIVENESS_WEIGHT_SCREEN=0.25
COMPOSITE_LIVENESS_THRESHOLD=0.55
QUALITY_GATE_ENABLED=true
QUALITY_MIN_BLUR=80
QUALITY_MIN_BRIGHTNESS=40
QUALITY_MAX_BRIGHTNESS=220
SPATIAL_BORDERLINE_LOW=0.45
SPATIAL_BORDERLINE_HIGH=0.70
SPATIAL_BORDERLINE_PASS_FRAC_LOW=0.30
STEP_UP_MIN_TEMPORAL=0.85
STEP_UP_ENABLED=true
REQUIRE_TEMPORAL=true
TEMPORAL_LIVENESS_THRESHOLD=0.45
SCREEN_SPOOF_THRESHOLD=0.46
BLUR_THRESHOLD=12

# Training / debug
# UAT: SAVE_TRAINING_DATA=true (capture every session for labeling). Production: false if PII policy requires.
SAVE_TRAINING_DATA=true
SHOW_DEBUG_IMAGES=true
# Auto incremental finetune — only enable after labels are clean; otherwise train manually on GPU.
BACKGROUND_TRAINING=false
TRAIN_INTERVAL_SEC=300
TRAIN_MIN_SAMPLES=8
LOG_LEVEL=INFO

# Face match providers (active one is also stored in DB face_match_providers; default internal=3)
INTERNAL_FACE_MATCH_THRESHOLD=0.45
CORE_MIDDLEWARE_URL=http://localhost:4018/core-middleware
NID_SERVICE_URL=http://localhost:8012/nid-verification
NID_USERNAME=your-nid-service-username
NID_PASSWORD=
NID_TIMEOUT=30
